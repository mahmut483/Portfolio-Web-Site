rules_version = '2';

// The browser never talks to Firestore. All reads and writes go through firebase-admin on the
// server (src/server), which bypasses these rules, after requireOwner(). The public web config
// is visible to anyone, so client access stays denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
